{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.2/.schema/devbox.schema.json",
  "packages": [
    "docker@latest",
    "python@3.13",
    "go-task@latest",
    "uv@latest"
  ],
  "env_from": ".env",
  "env": {
    "APP_ENV": "development"
  },
  "shell": {
    "init_hook": [
      "uv sync",
      "if [ -f .env.local ]; then export $(grep -v '^[[:space:]]*#' .env.local | grep '=' | sed 's/[[:space:]]*#[^=]*$//' | xargs); fi"
    ],
    "scripts": {
      "test": [
        "echo \"Error: no test specified\" && exit 1"
      ]
    }
  }
}